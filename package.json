{
  "name": "playwright-jev-triage",
  "version": "1.0.0",
  "description": "Playwright + Jev (TypeSafe System One): automatic triage of failed tests",
  "scripts": {
    "pretest": "node -e \"require('fs').rmSync('reports/local/allure-results',{recursive:true,force:true})\"",
    "test": "playwright test",
    "test:saucedemo": "node -e \"require('fs').rmSync('reports/saucedemo/allure-results',{recursive:true,force:true})\" && playwright test -c playwright.saucedemo.config.ts",
    "triage": "node --env-file-if-exists=.env --import tsx triage/triage.ts",
    "triage:saucedemo": "SUITE=saucedemo npm run triage",
    "test:triage": "npm test; npm run triage",
    "test:triage:saucedemo": "npm run test:saucedemo; npm run triage:saucedemo",
    "allure": "allure generate reports/*/allure-results",
    "allure:open": "allure open reports/allure-report",
    "typecheck": "tsc",
    "start": "tsx app/server.ts"
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "allure": "^3.21.0",
    "allure-playwright": "^3.13.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.7.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.15"
  }
}
