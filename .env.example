# Copy to .env (.env is in .gitignore and must never be committed).

# TypeSafe API key. Without it, triage runs in fallback mode (unclassified).
TYPESAFE_API_KEY=

# Jev model (SDK default: jev-latest). Pin a version once you have tuned the threshold, e.g. jev-1.13.0
# TYPESAFE_DEFAULT_MODEL=jev-latest

# Below this confidence (0–1), the failure becomes needs_review.
TRIAGE_CONFIDENCE_THRESHOLD=0.6

# Comma-separated verdicts that fail the job (bug, flaky, environment, needs_review, unclassified).
TRIAGE_FAIL_ON=bug

# --- Deliberate failures ---
# 1 = /api/inventory returns 503 (environment failure)
FAKE_ENV_DOWN=1
# Maximum delay (ms) of /api/report; the test waits 1000 ms.
FLAKY_MAX_DELAY_MS=2000
# 1 = in saucedemo, the "the inventory loads" test cuts off the network (environment failure)
SAUCE_ENV_DOWN=1

# With a bug verdict and P(test code defect) >= this value, the failure becomes needs_review.
TRIAGE_TEST_DEFECT_THRESHOLD=0.7
