# Copia para .env (o .env está no .gitignore e nunca deve ir para o git).

# Chave da API TypeSafe. Sem ela, a triagem corre em modo fallback (unclassified).
TYPESAFE_API_KEY=

# Modelo Jev (default do SDK: jev-latest). Fixa uma versão depois de afinares o limiar, ex.: jev-1.13.0
# TYPESAFE_DEFAULT_MODEL=jev-latest

# Abaixo deste confidence (0–1), a falha fica needs_review.
TRIAGE_CONFIDENCE_THRESHOLD=0.6

# Veredictos que fazem o job falhar, separados por vírgula (bug, flaky, environment, needs_review, unclassified).
TRIAGE_FAIL_ON=bug

# --- Falhas de propósito na app ---
# 1 = /api/inventory devolve 503 (falha de ambiente)
FAKE_ENV_DOWN=1
# Atraso máximo (ms) de /api/report; o teste espera 1000 ms.
FLAKY_MAX_DELAY_MS=2000
# 1 = no saucedemo, o teste "o inventário carrega" corta a rede (falha de ambiente)
SAUCE_ENV_DOWN=1

# Com veredicto bug e P(defeito no código do teste) >= este valor, a falha fica needs_review.
TRIAGE_TEST_DEFECT_THRESHOLD=0.7
